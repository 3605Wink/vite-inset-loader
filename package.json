{
  "name": "vite-inset-loader",
  "version": "2.0.2",
  "description": "在Vite构建的Vue应用中，编译阶段在SFC模板指定位置插入自定义内容，适用于需要在每个页面引入组件的小程序场景。",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3605Wink/vite-inset-loader.git"
  },
  "files": [
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "pnpm run build --watch --ignore-watch examples",
    "build": "tsup",
    "test": "cd examples/test && pnpm weixin",
    "prepublishOnly": "pnpm run build",
    "release": "npx bumpp --push --tag --commit && pnpm publish"
  },
  "keywords": [
    "vite",
    "loader",
    "vue",
    "uni-app",
    "component-injection"
  ],
  "author": "Jeddy",
  "license": "MIT",
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "bumpp": "^7.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.8",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.4.33",
    "tslog": "^4.9.3"
  }
}
