{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "rootDir": "src",
    "lib": [
      "ESNext"
    ],
    "sourceMap": false,
    "noEmitOnError": true,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "src/*",
    "*.d.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "dist",
    "temp"
  ]
}